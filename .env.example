# it has to match the Twitch redirect URL
PUBLIC_URL=http://cue.localhost:8080

# The hostname Caddy answers on. Deployment only; ignored by the dev server.
SITE_ADDRESS=cue.hoppy.ovh

# openssl rand -hex 32
COOKIE_SECRET=

# From https://dev.twitch.tv/console/apps
# Set the OAuth redirect URL to exactly {PUBLIC_URL}/auth/callback.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# From https://developer.spotify.com/dashboard
# Set the OAuth redirect URL to exactly {PUBLIC_URL}/auth/spotify/callback.
# Leave blank and Spotify is offered as "soon" instead
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Off by default: only admins and accounts that have linked Spotify before
# SPOTIFY_OPEN_LINKING=true

# Local development only. Spotify refuses "localhost"
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/auth/spotify/callback

# Twitch user ids that may open /admin. Comma separated, optional.
ADMIN_TWITCH_IDS=

# Optional overrides; every one has a sensible default.
# PORT=8080
# HOST=0.0.0.0
# DB_PATH=./data/app.db
# LOG_LEVEL=info
# SPOTIFY_POLL_MS=5000
# SPOTIFY_IDLE_POLL_MS=15000
