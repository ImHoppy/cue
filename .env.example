# it has to match the Twitch redirect URL
PUBLIC_URL=http://localhost:8080

# The hostname Caddy answers on. Deployment only; ignored by the dev server.
SITE_ADDRESS=hoppy.ovh

# openssl rand -hex 32
COOKIE_SECRET=

# From https://dev.twitch.tv/console/apps.
# Add every PUBLIC_URL you use as its own OAuth redirect URL, each ending in
# /auth/callback - Twitch accepts several, so one app covers local and live.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Twitch user ids that may open /admin. Comma separated, optional.
ADMIN_TWITCH_IDS=

# Optional overrides; every one has a sensible default.
# PORT=8080
# HOST=0.0.0.0
# DB_PATH=./data/app.db
# LOG_LEVEL=info
